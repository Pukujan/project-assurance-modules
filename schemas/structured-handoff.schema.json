{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/project-assurance-modules/schemas/structured-handoff.schema.json",
  "title": "PAM generic structured handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_kind",
    "project",
    "work",
    "methodology",
    "components",
    "validation",
    "next_action",
    "blockers",
    "scope",
    "decisions_not_to_reverse",
    "open_questions",
    "reconciliation",
    "hidden_evaluation",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "pam-handoff/0.1.0"},
    "state_kind": {"enum": ["current", "historical_checkpoint"]},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "phase"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repository": {
          "anyOf": [
            {"$ref": "#/$defs/repository"},
            {"type": "null"}
          ]
        },
        "phase": {"type": "string", "minLength": 1}
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owning_repository", "issue", "branch", "pr", "state"],
      "properties": {
        "owning_repository": {
          "anyOf": [
            {"$ref": "#/$defs/repository"},
            {"type": "null"}
          ]
        },
        "issue": {"type": ["integer", "null"], "minimum": 1},
        "branch": {"type": ["string", "null"], "minLength": 1},
        "pr": {"type": ["integer", "null"], "minimum": 1},
        "state": {
          "enum": ["planned", "in_progress", "blocked", "in_review", "validating", "complete"]
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "modules"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/git_sha"},
        "modules": {
          "type": "array",
          "items": {"$ref": "#/$defs/module_identity"},
          "uniqueItems": true
        }
      }
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component_state"},
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "not_run"],
      "properties": {
        "passed": {"type": "array", "items": {"$ref": "#/$defs/validation_result"}},
        "failed": {"type": "array", "items": {"$ref": "#/$defs/validation_result"}},
        "not_run": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue", "action", "acceptance"],
      "properties": {
        "repository": {
          "anyOf": [
            {"$ref": "#/$defs/repository"},
            {"type": "null"}
          ]
        },
        "issue": {"type": ["integer", "null"], "minimum": 1},
        "action": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1}
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do_not_start"],
      "properties": {
        "do_not_start": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "decisions_not_to_reverse": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_state_wins", "checks", "stale_state_behavior"],
      "properties": {
        "live_state_wins": {"const": true},
        "checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "stale_state_behavior": {
          "enum": ["stop_and_reconcile", "refresh_and_revalidate"]
        }
      }
    },
    "hidden_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_visible_hidden_material", "policy"],
      "properties": {
        "agent_visible_hidden_material": {"const": false},
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_from_identity", "created_at", "reason"],
      "properties": {
        "created_from_identity": {"$ref": "#/$defs/identity"},
        "created_at": {"type": "string", "format": "date-time"},
        "reason": {
          "enum": [
            "session_end",
            "agent_transfer",
            "repository_transfer",
            "pr_transition",
            "validation_transition",
            "milestone_transition",
            "blocked",
            "next_action_changed",
            "material_plan_change"
          ]
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "module_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "version"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["git_commit", "version", "digest", "immutable_uri", "other"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "git_commit"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"$ref": "#/$defs/git_sha"}}}
        }
      ]
    },
    "component_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "locator", "observed_identity", "tested_identity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "observed_identity": {
          "anyOf": [
            {"$ref": "#/$defs/identity"},
            {"type": "null"}
          ]
        },
        "tested_identity": {
          "anyOf": [
            {"$ref": "#/$defs/identity"},
            {"type": "null"}
          ]
        }
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
